# API Keys
OPENAI_API_KEY=sk-...          # required for embeddings + image generation
ANTHROPIC_API_KEY=sk-ant-...   # required for content generation (Claude)

# Database
DATABASE_URL=postgresql://dnd_app:your_password_here@localhost:5432/dnd_generator

# Application
BASE_URL=https://dnd.bradhinkel.com   # or http://localhost:3001 for local dev

# Paths (created automatically on first run)
IMAGES_DIR=/var/data/dnd-images
CHROMA_DB_PATH=/var/data/chroma_db

# Image generation
# Set to gpt-image-1 (or gpt-image-2) to enable DALL-E image generation.
# Leave blank to skip — items generate without art.
IMAGE_MODEL=gpt-image-1

# Set to true in local dev so images are served through the Next.js API proxy
# rather than requiring a public BASE_URL. Set to false in production.
IMAGE_PROXY=false

# Next.js (set during build / local dev)
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://localhost:8001
